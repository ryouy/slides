# Public address of the site (OG images and share links need an absolute address)
SITE_URL=https://example.com
VITE_SITE_URL=https://example.com

# Ads are on in production builds. Set this to "false" to build without any ad (e.g. a preview deploy).
# VITE_ADS_ENABLED=false

# ART SLIDE Premium (Free/Premium limits, sign-in, subscription). Leave unset until the backend is set up and
# tested in Stripe test mode (see README "Premium: setup"): unset = the site works exactly as the free static site.
# VITE_PREMIUM_ENABLED=true
