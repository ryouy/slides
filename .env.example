# Public address of the site (OG images and share links need an absolute address)
SITE_URL=https://example.com
VITE_SITE_URL=https://example.com

# Ads are on in production builds. Set this to "false" to build without any ad (e.g. a preview deploy).
# VITE_ADS_ENABLED=false
# Host+path of the Adsterra banner scripts as shown in the dashboard (the key is appended). Default:
# VITE_ADSTERRA_SCRIPT_BASE=https://bauval.org/22
