# Public address of the site (OG images and share links need an absolute address)
SITE_URL=https://example.com
VITE_SITE_URL=https://example.com

# Ads: nothing from the ad network is loaded in production unless this is "true".
# Turn it on only after checking the ad code/domain in the Adsterra dashboard.
VITE_ADS_ENABLED=false
# Host+path of the Adsterra banner scripts as shown in the dashboard (the key is appended). Default:
# VITE_ADSTERRA_SCRIPT_BASE=https://bauval.org/22
