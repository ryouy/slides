// Settings shared by Debug and Release. Edit the "YOU MUST SET" values (see ios/README.md); keep secrets out of this file.

// ---- YOU MUST SET: your own Bundle ID (reverse-DNS, e.g. com.yourname.artslide). Placeholder until then; it cannot be uploaded. ----
PRODUCT_BUNDLE_IDENTIFIER = invalid.placeholder.artslide
// ---- YOU MUST SET: your Apple Developer Team ID (10 characters) for signing on a real device / App Store ----
DEVELOPMENT_TEAM =

// Version shown to users / build number (raise the build number for every upload).
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// App Store Connect product id of the monthly auto-renewing subscription (must match exactly).
PREMIUM_PRODUCT_ID = com.ryouy.artslide.premium.monthly

// Worker that serves Premium paintings and verifies purchases.
SLIDES_API_BASE = https:/$()/slides.ryouy.workers.dev

// Google's published TEST ids (safe, public). Release.xcconfig overrides them with the production ids; Local.xcconfig (git-ignored) can override both.
ADMOB_APP_ID = ca-app-pub-3940256099942544~1458002511
ADMOB_BANNER_UNIT_ID = ca-app-pub-3940256099942544/2435281174

// Google Sign-In + Drive sync (optional). These are public identifiers (not secrets) of the iOS OAuth client in the same Cloud project as the web client.
// Local.xcconfig can override them. If GOOGLE_IOS_CLIENT_ID is empty or `invalid.apps.googleusercontent.com`, the Google section in Settings is hidden.
GOOGLE_IOS_CLIENT_ID = 206659959670-tkll3cb46ohed7350bcshhgi8osd15i6.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.206659959670-tkll3cb46ohed7350bcshhgi8osd15i6

// Optional, git-ignored file for your real values (Bundle ID, Team ID, product id, real AdMob ids).
#include? "Local.xcconfig"
