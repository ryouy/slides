<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- This manifest describes what the APP ITSELF collects. The advertising SDKs (Google Mobile Ads, Google UMP) ship their own
	     PrivacyInfo.xcprivacy with their data types, linking and required-reason APIs; Xcode merges them into the Privacy Report, so
	     they are deliberately not repeated here. See docs/IOS_PRIVACY.md for the full App Store Connect answers.
	     NSPrivacyTracking is true because the embedded Google Mobile Ads SDK uses the advertising identifier for tracking when the user
	     allows it (App Tracking Transparency); the SDKs declare no tracking domains, so none are listed. -->
	<key>NSPrivacyTracking</key>
	<true/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Sign in with Apple (optional): Apple's user id and our own account id are stored on our server. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key><string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key><true/>
			<key>NSPrivacyCollectedDataTypeTracking</key><false/>
			<key>NSPrivacyCollectedDataTypePurposes</key><array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
		</dict>
		<!-- Records sync (optional, off by default): the three games' records are stored on our server. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key><string>NSPrivacyCollectedDataTypeGameplayContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key><true/>
			<key>NSPrivacyCollectedDataTypeTracking</key><false/>
			<key>NSPrivacyCollectedDataTypePurposes</key><array><string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string></array>
		</dict>
	</array>
	<!-- No "required reason" API is used by the app's own code (no UserDefaults, file timestamps, boot time or disk-space calls). -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
