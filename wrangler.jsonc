// Cloudflare Worker for the site: static files from ./dist plus the /api/* routes (Google sign-in, Stripe, plan lookup).
// The Worker runs ONLY for /api/*; every other request is served straight from the static assets, as before.
// The D1 database "slides-db" must have migrations/0001_init.sql applied BEFORE the secrets are set (README "Premium: setup").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slides",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SITE_URL": "https://slides.ryouy.workers.dev"
    // PURCHASES_ENABLED is deliberately NOT here: it is a Secret set in the dashboard (Settings → Variables and Secrets),
    // so it can be switched on/off instantly without a deploy. Absent or anything but "true" = purchases are OFF.
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slides-db",
      "database_id": "477ac683-93d6-4d57-a8e9-18d699c57ab7",
      "migrations_dir": "migrations"
    }
  ]

  // Secrets (set with `npx wrangler secret put <NAME>` or in the dashboard, never committed). Until they are all set,
  // every account/billing API answers 503 and the site works exactly as before:
  //   SESSION_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_ID
}
