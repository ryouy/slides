// Cloudflare Worker for the site: static files from ./dist plus the /api/* routes (Google sign-in, Stripe, plan lookup).
// The Worker runs ONLY for /api/*; every other request is served straight from the static assets, as before.
// Setup (D1, Google, Stripe, secrets): see README "Premium: setup".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slides",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "SITE_URL": "https://slides.ryouy.workers.dev"
  },
  "observability": { "enabled": true }

  // The D1 database is NOT bound yet, on purpose: without it every account/billing API answers 503 and the
  // site works exactly as before. After `npx wrangler d1 create slides`, add the block below with the REAL id
  // (never a placeholder: a wrong id makes the deploy fail), then apply migrations/0001_init.sql.
  //
  // ,"d1_databases": [
  //   { "binding": "DB", "database_name": "slides", "database_id": "<REAL id printed by wrangler d1 create>", "migrations_dir": "migrations" }
  // ]
  //
  // Secrets (set with `npx wrangler secret put <NAME>`, never committed):
  //   SESSION_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_ID
}
